# Normalise line endings so the repo does not churn on Windows checkouts.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Source and docs
*.cs    text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.ps1   text eol=lf
*.xml   text eol=lf
*.json  text eol=lf

# Binaries — never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.webp  binary
*.apk   binary
*.exe   binary
*.keystore binary
*.jks   binary
*.pfx   binary

# Generated / vendored data that must never be diffed
tests/vectors/** binary
