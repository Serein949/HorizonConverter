<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Public ("正式") Android build. Shares the Alpha app's code and UI assets but installs
    side by side (different ApplicationId), ships its own label and icons, and only
    exposes PNG -> TTX and WAV -> TSB (see PUBLIC_BUILD in MainActivity.cs).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);PUBLIC_BUILD</DefineConstants>
    <ApplicationId>com.aeroflyconv.converter</ApplicationId>
    <ApplicationVersion>7</ApplicationVersion>
    <ApplicationDisplayVersion>1.21.5</ApplicationDisplayVersion>
    <Version>1.21.5</Version>
    <Product>Aerofly 转换器</Product>
    <AssemblyName>AeroflyConv.Public</AssemblyName>
    <RootNamespace>AeroflyConv.Android</RootNamespace>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <NoWarn>$(NoWarn);NU1701;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AeroflyConv.Android\MainActivity.cs" Link="MainActivity.cs" />
    <!-- Shared UI assets only: labels (values) and launcher bitmaps (mipmap-*) are per project. -->
    <AndroidResource Include="..\AeroflyConv.Android\Resources\drawable\*"
                     Link="Resources\drawable\%(Filename)%(Extension)" />
    <AndroidResource Include="..\AeroflyConv.Android\Resources\layout\*"
                     Link="Resources\layout\%(Filename)%(Extension)" />
    <AndroidResource Include="..\AeroflyConv.Android\Resources\color\*"
                     Link="Resources\color\%(Filename)%(Extension)" />
    <AndroidResource Include="..\AeroflyConv.Android\Resources\values\ic_launcher_background.xml"
                     Link="Resources\values\ic_launcher_background.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AeroflyConv.Core\AeroflyConv.Core.csproj" />
  </ItemGroup>

</Project>
