<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_window"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="30dp">

        <!-- header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:text="Aerofly 转换器"
                android:textColor="#F5F8FD"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/tvEdition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="Alpha"
                android:textColor="#4FD8FF"
                android:textSize="42sp" />
        </LinearLayout>

        <!-- mode: a glass segmented control, no card frame -->
        <LinearLayout
            android:id="@+id/cardMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_track"
                android:orientation="vertical"
                android:padding="5dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llModes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- files -->
        <LinearLayout
            android:id="@+id/cardFiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass"
            android:elevation="8dp"
            android:outlineProvider="background"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.14"
                    android:text="文件"
                    android:textColor="#8B98A9"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvFileCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#4FD8FF"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="还没有文件\n添加 .ttx / .tsb / .ttc / .tm / .png / .wav"
                android:textColor="#6B7788"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddFiles"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/bg_ghost"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="添加文件"
                    android:textAllCaps="false"
                    android:textColor="#F5F8FD"
                    android:textSize="13.5sp" />

                <Button
                    android:id="@+id/btnAddFolder"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1.1"
                    android:background="@drawable/bg_ghost"
                    android:stateListAnimator="@null"
                    android:text="文件夹"
                    android:textAllCaps="false"
                    android:textColor="#DCE6F2"
                    android:textSize="13.5sp" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="0.62"
                    android:background="@drawable/bg_ghost"
                    android:stateListAnimator="@null"
                    android:text="清空"
                    android:textAllCaps="false"
                    android:textColor="#8B98A9"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <!-- output lives inside the files card as one quiet row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="输出"
                    android:textColor="#8B98A9"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvOutput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:text="Download/AeroflyConv"
                    android:textColor="#AFBCCB"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnPickOutput"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_ghost_small"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:stateListAnimator="@null"
                    android:text="更改"
                    android:textAllCaps="false"
                    android:textColor="#8FE4FF"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- options -->
        <LinearLayout
            android:id="@+id/cardOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass"
            android:elevation="8dp"
            android:outlineProvider="background"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="选项"
                android:textColor="#8B98A9"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/rowFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="格式"
                    android:textColor="#DCE6F2"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llFormat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_track"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="贴图尺寸"
                    android:textColor="#DCE6F2"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_track"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowQuality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="编码质量"
                    android:textColor="#DCE6F2"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llQuality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_track"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/tvQualityHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="仅对 ASTC 生效：快速更快，高质量更慢更准。"
                    android:textColor="#7A8798"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#1FFFFFFF" />

            <LinearLayout
                android:id="@+id/rowFlip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="垂直翻转"
                        android:textColor="#DCE6F2"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aerofly 贴图行序自下而上"
                        android:textColor="#7A8798"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swFlip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#F2F7FF"
                    android:trackTint="#3DFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowCompress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="压缩 TTX（LZHAM）"
                        android:textColor="#DCE6F2"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="与游戏内文件相同的容器"
                        android:textColor="#7A8798"
                        android:textSize="11sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swCompress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#F2F7FF"
                    android:trackTint="#3DFFFFFF" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowTtcMips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TTC 多级贴图"
                    android:textColor="#DCE6F2"
                    android:textSize="13sp" />

                <Switch
                    android:id="@+id/swTtcMips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#F2F7FF"
                    android:trackTint="#3DFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- convert -->
        <Button
            android:id="@+id/btnConvert"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary"
            android:elevation="12dp"
            android:outlineProvider="background"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:stateListAnimator="@null"
            android:text="开始转换"
            android:textAllCaps="false"
            android:textColor="#04121A"
            android:textSize="16.5sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#26FFFFFF"
            android:progressTint="#4FD8FF"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="就绪"
            android:textColor="#94A1B2"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/rowResultActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btnOpen"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ghost"
                android:stateListAnimator="@null"
                android:text="打开结果"
                android:textAllCaps="false"
                android:textColor="#F5F8FD"
                android:textSize="13.5sp" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ghost"
                android:stateListAnimator="@null"
                android:text="分享"
                android:textAllCaps="false"
                android:textColor="#DCE6F2"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- log: collapsed glass card, header toggles it -->
        <LinearLayout
            android:id="@+id/cardLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass"
            android:elevation="8dp"
            android:outlineProvider="background"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/rowLogHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLogChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="›"
                    android:textColor="#8FE4FF"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.14"
                    android:text="日志"
                    android:textColor="#8B98A9"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvLogCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text=""
                    android:textColor="#5C6779"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnLogCopy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ghost_small"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="复制"
                    android:textColor="#C6CEDA"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnLogClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_ghost_small"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="清空"
                    android:textColor="#C6CEDA"
                    android:textSize="11sp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scrollLog"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_log"
                android:fadeScrollbars="false"
                android:padding="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#B6C2D1"
                    android:textIsSelectable="true"
                    android:textSize="11.5sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
