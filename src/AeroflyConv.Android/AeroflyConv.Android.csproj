<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.horizonconverter.app</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <Version>1.1.0</Version>
    <Product>Horizon Converter</Product>
    <AssemblyName>HorizonConverter.Android</AssemblyName>
    <RootNamespace>AeroflyConv.Android</RootNamespace>
    <!-- The audio decoders use reflection; keep trimming conservative. -->
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Release signing: keys/signing.local.props is machine-local and gitignored. -->
  <Import Project="..\..\keys\signing.local.props" Condition="Exists('..\..\keys\signing.local.props')" />

  <ItemGroup>
    <ProjectReference Include="..\AeroflyConv.Core\AeroflyConv.Core.csproj" />
  </ItemGroup>

</Project>
