<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AeroflyConv.Core\AeroflyConv.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>HorizonConverter</AssemblyName>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <Product>Horizon Converter</Product>
    <Company>AeroflyConv</Company>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared with the CLI: GDI+ image decoding (no bundled codec). -->
    <Compile Include="..\AeroflyConv.Cli\DesktopImageDecoder.cs" Link="DesktopImageDecoder.cs" />
  </ItemGroup>

</Project>

